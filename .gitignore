# Local editor/agent session config
.claude/

# SQLite runtime files. The WAL and shm are live state that belongs to
# whichever process has the database open. Tracking them while forge.db
# itself is ignored lets a checkout restore an old WAL over a newer
# database, which corrupts it.
forge.db
forge.db-shm
forge.db-wal

# Database backups taken before a repair
forge.db.backup-*

# File-sync duplicates ("name 2.js"). One of these was a rollback migration
# that ran forward and dropped six tables — they never belong in the repo.
* [0-9].*

# Submitted coursework. Never committed — it is user data, and the whole point
# of gating /uploads behind auth is that it does not travel.
uploads/
