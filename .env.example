# Forge configuration. Copy to .env and fill in.

PORT=3000
# Required in production; a value under 32 characters aborts startup.
JWT_SECRET=

# --- Discord bridge (optional) ---
# Leave these blank and Forge runs normally with the bridge disabled; it logs
# exactly which values are missing at boot. Supplied by whoever set up the
# Discord server and the three bot applications.
DISCORD_GUILD_ID=
DISCORD_SYSTEM_BOT_TOKEN=
DISCORD_ADMIN_BOT_TOKEN=
DISCORD_MESSENGER_BOT_TOKEN=

# Static channels, one per pre-made channel. The suffix becomes the name:
# DISCORD_CHANNEL_GENERAL=123 maps to "general".
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_OFF_TOPIC=
DISCORD_CHANNEL_SYSTEM_ALERTS=

# Categories the System Bot creates channels under.
DISCORD_CATEGORY_TEAMS=
DISCORD_CATEGORY_DIRECT_MESSAGES=

# Enables GIF search in the message composer; optional.
TENOR_API_KEY=
